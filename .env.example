# Brevo API Key - Get from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxx

# API Secret for webhook authentication - Generate with: openssl rand -base64 32
API_SECRET_KEY=your-secret-key-here

# WooCommerce Webhook Secret - Generate with: openssl rand -base64 32
WOOCOMMERCE_WEBHOOK_SECRET=your-woocommerce-secret-here

# WordPress login username (for Basic Auth with App Password)
WP_USER=your-wp-user

# WordPress App Password for WooCommerce REST API (coupon creation)
WP_APP_PASSWORD=your-wp-app-password

# Email that receives LinkedIn approval requests, weekly reports, token alerts, blog alerts
APPROVAL_EMAIL=your-approval-email@example.com

# Calendly post-consultation email
CALENDLY_EMAIL_TEMPLATE_ID=158
CALENDLY_WEBHOOK_SECRET=your-calendly-signing-key

# Zernio API Key for LinkedIn posting - Get from https://zernio.com
ZERNIO_API_KEY=sk_xxx

# Vercel KV (automatically added when you create a KV store in Vercel)
# KV_URL=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# KV_REST_API_READ_ONLY_TOKEN=

# ── Filtro "¿ya es cliente?" (PRD-filtro-cliente / T8) ──
# La lectura de órdenes de WooCommerce reusa WP_USER / WP_APP_PASSWORD (arriba).
# Requiere también el service account de Google (GOOGLE_SERVICE_ACCOUNT_JSON o
# GOOGLE_SERVICE_ACCOUNT_EMAIL + GOOGLE_PRIVATE_KEY) para el Sheet CRM.

# ID del Sheet CRM (default: el del PRD). Override sólo si cambia el Sheet.
# CRM_SHEET_ID=1bGAISPvP3QApE99o2Rz1A_f-zAGs-W3X7UrODcjUWiM

# ID de la lista Brevo "Compradores Programa 3740" (la crea el backfill; copiar
# el id que devuelve el run real). Sin esto, el webhook no agrega a esa lista.
# BREVO_LIST_COMPRADORES_3740=

# Carpeta Brevo donde crear la lista nueva (default 1 = raíz).
# BREVO_LIST_FOLDER_ID=1

# Cron reconciliador: por seguridad NO escribe por default. Poner en "true" para
# habilitar correcciones automáticas + log a la hoja "Reconciliación".
# RECONCILIAR_APPLY=false
